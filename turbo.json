{
  "$schema": "https://turborepo.dev/schema.json",
  "concurrency": "13",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "JWT_SECRET", "SESSION_SECRET"]
    }
  }
}
