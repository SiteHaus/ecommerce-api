meta {
  name: Update Collection
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/v1/admin/collections/{{collectionId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "description": "Our most popular supplements — updated."
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("description is updated", function() {
    expect(res.body.description).to.equal("Our most popular supplements — updated.");
  });
}
