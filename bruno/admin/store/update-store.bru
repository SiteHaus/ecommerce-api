meta {
  name: Update Store
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/v1/admin/stores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "OneHealth Clinics Store"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("name is updated", function() {
    expect(res.body.name).to.equal("OneHealth Clinics Store");
  });
}
