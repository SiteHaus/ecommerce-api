meta {
  name: List Products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/admin/products
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("returns items array", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.total).to.be.a("number");
  });
}
