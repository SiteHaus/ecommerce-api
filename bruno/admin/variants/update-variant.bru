meta {
  name: Update Variant
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/v1/admin/variants/{{newVariantId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "priceCents": 8999,
    "isActive": true
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("price updated", function() {
    expect(res.body.priceCents).to.equal(8999);
  });
}
