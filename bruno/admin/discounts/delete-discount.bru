meta {
  name: Delete Discount
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/v1/admin/discounts/{{autoDiscountId}}
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("returns success message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
