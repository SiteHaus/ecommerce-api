meta {
  name: Get Collection by Slug
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/catalog/collections/{{collectionSlug}}
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("returns collection with products", function() {
    expect(res.body.slug).to.be.a("string");
  });
}
