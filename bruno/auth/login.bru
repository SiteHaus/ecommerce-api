meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{iamUrl}}/auth/login
  body: json
  auth: none
}

headers {
  x-client-key: {{iamClientKey}}
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  console.log("status:", res.status);
  console.log("body keys:", Object.keys(res.body || {}));
  console.log("accessToken:", res.body?.accessToken);
  if (res.status === 200 && res.body.accessToken) {
    bru.setEnvVar("adminToken", res.body.accessToken);
    console.log("adminToken set");
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("received accessToken", function() {
    expect(res.body.accessToken).to.be.a("string");
  });
}
