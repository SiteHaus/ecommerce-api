{
  "name": "@sitehaus-ecom/database",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "db:gen": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@sitehaus-ecom/typescript-config": "workspace:*",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.0",
    "dotenv": "^16.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.3"
  }
}
