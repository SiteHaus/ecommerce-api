NODE_ENV=development

DATABASE_URL=postgresql://ecom:ecom@localhost:5433/ecommerce
# Tune alongside Postgres max_connections for your expected concurrent store count
DB_POOL_SIZE=10

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_CDN_URL=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

# EasyPost — platform-level key, used to provision per-store child accounts.
# Never exposed to clients, never selectable per request.
EASYPOST_API_KEY=
