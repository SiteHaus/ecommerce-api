NODE_ENV=development

DATABASE_URL=postgres://user:password@localhost:5432/sitehaus_ecom
DB_POOL_SIZE=5

# Stripe — never share these keys outside the payments service
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# sitehaus (main repo) apps/api base URL and shared secret — used once per
# store to resolve/create the reused SiteHaus billing Stripe customer.
API_URL=https://api.sitehaus.dev
COMMERCE_SERVICE_KEY=
