NODE_ENV=development
PORT=7020

# PostgreSQL — store resolution middleware only
DATABASE_URL=postgresql://ecom:ecom@localhost:5433/ecommerce

# Redis — throttler storage
REDIS_URL=redis://localhost:6380

# SiteHaus IAM — register this gateway as a SiteHaus OAuth client to get these
IAM_URL=https://api.sitehaus.io
IAM_CLIENT_KEY=

# Anonymous session tokens for guest carts
# Must be at least 32 chars
SESSION_SECRET=

# Internal TCP service hosts (use service names in Docker, localhost in dev)
COMMERCE_HOST=localhost
PAYMENTS_HOST=localhost
