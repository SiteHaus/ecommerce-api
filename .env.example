POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://ecom:ecom@localhost:5433/ecommerce
REDIS_URL=redis://localhost:6380

# SiteHaus IAM — get from your SiteHaus dashboard
IAM_URL=https://iam.sitehaus.io
IAM_CLIENT_KEY=your-client-key-here

# Gateway
SESSION_SECRET=change-me-to-a-random-32-char-string-xx

# Seed — set to your IAM user's clientId before running `node --experimental-strip-types scripts/seed.ts`
# Find it by decoding your access token at jwt.io (look for the `clientId` field in the payload)
SEED_CLIENT_ID=
