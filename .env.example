POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://ecom:ecom@localhost:5433/ecommerce
REDIS_URL=redis://localhost:6380

# SiteHaus IAM — use the 'sitehaus-commerce' confidential client secret from the IAM dashboard
IAM_URL=https://iam.sitehaus.io
IAM_CLIENT_KEY=your-client-secret-here

# Gateway
SESSION_SECRET=change-me-to-a-random-32-char-string-xx

# CORS allow-list — static origins (admin UI + known storefronts), comma-separated.
# Active store domains are additionally allowed automatically at request time.
CORS_ALLOWED_ORIGINS=https://commerce.localhost:3004
# Soak mode: false logs disallowed origins but still permits them. Flip to true
# to enforce rejection after observing real traffic in staging.
CORS_ENFORCE=false

# Stripe — get from https://dashboard.stripe.com/test/apikeys
# STRIPE_WEBHOOK_SECRET: run `stripe listen --forward-to localhost:7020/v1/webhooks/stripe` for local dev
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Lighthaus liveness heartbeat (worker → SiteHaus monitoring). Optional — the
# pusher stays off when unset (local dev). Secret must match lighthaus-api's
# HEARTBEAT_SECRET.
LIGHTHAUS_HEARTBEAT_URL=https://lighthaus-api.sitehaus.dev/heartbeat
LIGHTHAUS_HEARTBEAT_SECRET=

# Seed — set to your IAM user's clientId before running `node --experimental-strip-types scripts/seed.ts`
# Find it by decoding your access token at jwt.io (look for the `clientId` field in the payload)
SEED_CLIENT_ID=
